# Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here

# Default AI Intelligence Provider: groq | openai | gemini | builtin
DEFAULT_PROVIDER=groq

# Default Model for taking prompts
DEFAULT_MODEL=llama-3.3-70b-versatile
